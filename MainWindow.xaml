<Window
    x:Class="JakeyTTS.DiscordBridge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="JakeyTTS - Discord Bridge">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="40" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="Assets/Square44x44Logo.scale-200.png" Width="20" Height="20" Margin="12,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="JakeyTTS - Discord Bridge" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <NavigationView x:Name="NavView" Grid.Row="1" ItemInvoked="NavView_ItemInvoked" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left" Background="Transparent">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Home" Content="Dashboard" Icon="Home" />
                <NavigationViewItem Tag="Events" Content="Broadcast Events" Icon="Audio" />
                <NavigationViewItem Tag="Commands" Content="Discord Commands" Icon="Message" />
            </NavigationView.MenuItems>

            <Grid Padding="30">
                <Grid x:Name="HomePage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE767;" FontSize="28" Foreground="MediumOrchid"/>
                        <TextBlock Text="Discord Voice Bridge" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ConnectBtn" Content="Start Bot" Click="ConnectBtn_Click" Style="{StaticResource AccentButtonStyle}" Width="120"/>
                            <Button x:Name="DisconnectBtn" Content="Stop" Click="DisconnectBtn_Click" IsEnabled="False" Width="100"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="DiscordStatusDot" Width="10" Height="10" Fill="Red"/>
                                <TextBlock Text="Discord"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="JakeyStatusDot" Width="10" Height="10" Fill="Red"/>
                                <TextBlock Text="JakeyTTS Server"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="LogBlock" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" PlaceholderText="System logs..." BorderThickness="0" FontSize="12" FontFamily="Cascadia Code, Consolas"/>
                    </Border>
                </Grid>

                <Grid x:Name="EventsPage" Visibility="Collapsed">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Broadcasting Preferences" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="15">
                                <ToggleSwitch x:Name="ToggleTest" Header="Test Audio &amp; Previews" IsOn="True" Toggled="EventToggle_Toggled" />
                                <ToggleSwitch x:Name="ToggleCommands" Header="Chat Commands (!tts)" IsOn="True" Toggled="EventToggle_Toggled" />
                                <ToggleSwitch x:Name="ToggleRedeems" Header="Channel Point Redeems" IsOn="True" Toggled="EventToggle_Toggled" />
                                <ToggleSwitch x:Name="ToggleBits" Header="Bits &amp; Cheers" IsOn="True" Toggled="EventToggle_Toggled" />
                                <ToggleSwitch x:Name="ToggleSubs" Header="Subscriptions &amp; Gifts" IsOn="True" Toggled="EventToggle_Toggled" />
                                <ToggleSwitch x:Name="ToggleChat" Header="Normal Chat Messages" IsOn="False" Toggled="EventToggle_Toggled" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="CommandsPage" Visibility="Collapsed">
                    <ScrollViewer>
                        <StackPanel Spacing="20">
                            <TextBlock Text="Slash Command Management" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="15">
                                    <TextBlock Text="Standard TTS Commands" FontWeight="SemiBold" FontSize="14" Opacity="0.8"/>
                                    <ToggleSwitch x:Name="ToggleJoinCmd" Header="/join - Joins your voice channel" IsOn="True" />
                                    <ToggleSwitch x:Name="ToggleLeaveCmd" Header="/leave - Leaves the voice channel" IsOn="True" />
                                    <ToggleSwitch x:Name="ToggleSpeakCmd" Header="/speak - Synthesize text in call" IsOn="True" />
                                    <ToggleSwitch x:Name="ToggleFileCmd" Header="/file - Send audio file to chat" IsOn="True" />

                                    <MenuFlyoutSeparator Margin="0,10"/>

                                    <TextBlock Text="Administrative Permissions Helpers" FontWeight="SemiBold" FontSize="14" Opacity="0.8"/>
                                    <ToggleSwitch x:Name="ToggleAllowChannelCmd" Header="/allow-this-channel - Authorize text channels dynamically" IsOn="True" />
                                    <ToggleSwitch x:Name="ToggleAllowRoleCmd" Header="/allow-role - Authorize server roles dynamically" IsOn="True" />
                                    <ToggleSwitch x:Name="ToggleClearPermsCmd" Header="/clear-permissions - Reset barriers to Open Mode" IsOn="True" />

                                    <Button Content="Sync Discord Commands" Click="UpdateCommands_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,15,0,0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Access &amp; Security Permissions Data" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="15">
                                    <TextBox x:Name="AllowedChannelsBox" 
                             Header="Allowed Channel IDs (Leave empty for all)" 
                             PlaceholderText="e.g., 1122334455667788, 9988776655443322" 
                             LostFocus="Permissions_Changed"/>

                                    <TextBox x:Name="AllowedRolesBox" 
                             Header="Allowed Role IDs (Leave empty for all)" 
                             PlaceholderText="e.g., 5544332211009988, 1122446688001122" 
                             LostFocus="Permissions_Changed"/>

                                    <TextBlock Text="ℹ Leave fields blank to allow unrestricted use across the entire server. Separate multiple IDs with commas." 
                               FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer>
                        <StackPanel Spacing="20" MaxWidth="800" HorizontalAlignment="Left">
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="15">
                                    <TextBlock Text="Connection Settings" FontWeight="Bold" FontSize="16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="TokenBox" Header="Discord Bot Token" PlaceholderText="Paste token here..." VerticalAlignment="Bottom"/>
                                        <Button Grid.Column="1" Click="ShowTokenInstructions_Click" Margin="8,0,0,0" VerticalAlignment="Bottom" Padding="8" Background="Transparent" BorderThickness="0">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="16"/>
                                        </Button>
                                    </Grid>
                                    <TextBox x:Name="ServerUrlBox" Header="JakeyTTS WebSocket URL" PlaceholderText="ws://localhost:8889/"/>
                                    <Button x:Name="InviteBtn" Content="Invite Bot to Server" Click="InviteBtn_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="15">
                                    <TextBlock Text="Appearance" FontWeight="Bold" FontSize="16"/>
                                    <ComboBox x:Name="ThemeBox" Header="Application Theme" SelectionChanged="ThemeBox_SelectionChanged" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="System Default"/>
                                        <ComboBoxItem Content="Light Mode"/>
                                        <ComboBoxItem Content="Dark Mode"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Info" FontWeight="Bold"/>
                                    <TextBlock Text="Commands are registered as Global Slash Commands (/). Click Sync to update them." FontSize="13"/>
                                    <HyperlinkButton Content="Discord Developer Portal" Click="OpenPortalBtn_Click" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>