<Window
    x:Class="JakeyTTS.DiscordBridge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="JakeyTTS - Discord Bridge">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Modern Title Bar -->
        <Grid x:Name="AppTitleBar" Height="40" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="Assets/Square44x44Logo.scale-200.png" 
                   Width="20" Height="20" 
                   Margin="12,0,12,0"
                   VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" 
                       Text="JakeyTTS - Discord Bridge" 
                       VerticalAlignment="Center" 
                       FontSize="12" 
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <NavigationView x:Name="NavView" 
                        Grid.Row="1"
                        ItemInvoked="NavView_ItemInvoked" 
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        Background="Transparent">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Home" Content="Dashboard" Icon="Home" />
                <NavigationViewItem Tag="Events" Content="Broadcast Events" Icon="Audio" />
            </NavigationView.MenuItems>

            <Grid Padding="30">
                <!-- 1. DASHBOARD -->
                <Grid x:Name="HomePage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE767;" FontSize="28" Foreground="MediumOrchid"/>
                        <TextBlock Text="Discord Voice Bridge" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ConnectBtn" Content="Start Bot" Click="ConnectBtn_Click" 
                                    Style="{StaticResource AccentButtonStyle}" Width="120"/>
                            <Button x:Name="DisconnectBtn" Content="Stop" Click="DisconnectBtn_Click" 
                                    IsEnabled="False" Width="100"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="DiscordStatusDot" Width="10" Height="10" Fill="Red"/>
                                <TextBlock Text="Discord"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="JakeyStatusDot" Width="10" Height="10" Fill="Red"/>
                                <TextBlock Text="JakeyTTS Server"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="LogBlock" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 PlaceholderText="System logs will appear here..."
                                 BorderThickness="0" FontSize="12" FontFamily="Cascadia Code, Consolas"/>
                    </Border>
                </Grid>

                <!-- 2. EVENTS (Added Toggled events to sync with server) -->
                <Grid x:Name="EventsPage" Visibility="Collapsed">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Broadcasting Preferences" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <TextBlock Text="Toggle which events are sent to your Discord call in real-time." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="15">
                                <ToggleSwitch x:Name="ToggleTest" Header="Test Audio &amp; Previews" IsOn="True" Toggled="EventToggle_Toggled" />
                                <ToggleSwitch x:Name="ToggleCommands" Header="Chat Commands (!tts)" IsOn="True" Toggled="EventToggle_Toggled" />
                                <ToggleSwitch x:Name="ToggleRedeems" Header="Channel Point Redeems" IsOn="True" Toggled="EventToggle_Toggled" />
                                <ToggleSwitch x:Name="ToggleBits" Header="Bits &amp; Cheers" IsOn="True" Toggled="EventToggle_Toggled" />
                                <ToggleSwitch x:Name="ToggleSubs" Header="Subscriptions &amp; Gifts" IsOn="True" Toggled="EventToggle_Toggled" />
                                <ToggleSwitch x:Name="ToggleChat" Header="Normal Chat Messages" IsOn="False" Toggled="EventToggle_Toggled" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 3. SETTINGS -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="20" Padding="0,0,20,0">
                        <TextBlock Text="Bot Configuration" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="TokenBox" Header="Discord Bot Token" PlaceholderText="Paste token here..." PasswordRevealMode="Peek"/>
                        <Button x:Name="InviteBtn" Content="Invite Bot to Server" Click="InviteBtn_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Quick Setup Guide" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="1. Create a Bot in Discord Developer Portal." FontSize="13" TextWrapping="Wrap"/>
                            <HyperlinkButton Content="Open Portal" Click="OpenPortalBtn_Click" FontSize="13"/>
                            <TextBlock Text="2. Turn ON 'Message Content Intent' in the Bot tab." Foreground="OrangeRed" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock Text="3. Paste token and click Invite." FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>