<Window
    x:Class="JakeyTTS.DiscordBridge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="JakeyTTS - Discord Bridge">

    <Grid Padding="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Settings -->
            <RowDefinition Height="*"/>
            <!-- Logs -->
            <RowDefinition Height="Auto"/>
            <!-- Status Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE767;" FontSize="28" Foreground="MediumOrchid"/>
            <TextBlock Text="Discord Voice Bridge" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold"/>
        </StackPanel>

        <!-- Settings Area -->
        <StackPanel Grid.Row="1" Spacing="15" Margin="0,0,0,20">
            <StackPanel Spacing="5">
                <PasswordBox x:Name="TokenBox" Header="Discord Bot Token" 
                             PlaceholderText="Enter your bot token here..." 
                             PasswordRevealMode="Peek"/>

                <!-- NEW: Horizontal layout for the two help buttons -->
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <HyperlinkButton Content="How do I create a Bot and get a Token?" 
                                     Click="HowToTokenBtn_Click" 
                                     FontSize="12" Opacity="0.8"/>

                    <HyperlinkButton x:Name="InviteBtn" 
                                     Content="Invite Bot to Server" 
                                     Click="InviteBtn_Click" 
                                     FontSize="12" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="ConnectBtn" Content="Start Bot" Click="ConnectBtn_Click" 
                        Style="{StaticResource AccentButtonStyle}" Width="120"/>
                <Button x:Name="DisconnectBtn" Content="Stop" Click="DisconnectBtn_Click" 
                        IsEnabled="False" Width="100"/>
            </StackPanel>
        </StackPanel>

        <!-- Log Console -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <TextBox x:Name="LogBlock" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     PlaceholderText="Logs will appear here..."
                     BorderThickness="0" FontSize="12" FontFamily="Cascadia Code, Consolas"/>
        </Border>

        <!-- Status Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="20" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="DiscordStatusDot" Width="10" Height="10" Fill="Red"/>
                <TextBlock Text="Discord"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="JakeyStatusDot" Width="10" Height="10" Fill="Red"/>
                <TextBlock Text="JakeyTTS Server"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>